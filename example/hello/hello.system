<system>
    <memory_region name="m0" size="0x10_000" phys_addr="0xa0000000" />

    <protection_domain name="hello" priority="254">
        <program_image path="hello.elf" />
        <map mr="m0" vaddr="0x2_000_000" perms="rwC" cached="false" setvar_vaddr="virt_addr" />
    </protection_domain>
</system>
